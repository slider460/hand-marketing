---
// Демо-сравнение: оригинал Тильды vs лёгкий код (B). Оба на ширине 1200px, отмасштабированы.
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Сравнение: оригинал vs лёгкий код</title>
  <style>
    *{box-sizing:border-box;margin:0}
    body{font-family:Arial,sans-serif;background:#222;color:#fff}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:2px;background:#444}
    .col{background:#fff;overflow:hidden}
    .lbl{background:#111;color:#fff;font-size:14px;font-weight:700;padding:8px 12px;letter-spacing:.04em}
    .lbl.b{background:#0a7d2c}
    /* окно показа фиксированной ширины 1200 масштабируем до ширины колонки (~728px) → 0.6 */
    .frame{width:1200px;height:1000px;transform:scale(.606);transform-origin:top left}
    .stage{height:606px;overflow:hidden}
    iframe{width:1200px;height:1000px;border:0;display:block}
  </style>
</head>
<body>
  <div class="grid">
    <div class="col">
      <div class="lbl">ОРИГИНАЛ (Тильда) = подход A</div>
      <div class="stage"><div class="frame"><iframe src="http://localhost:8080/" loading="eager"></iframe></div></div>
    </div>
    <div class="col">
      <div class="lbl b">ЛЁГКИЙ КОД (подход B)</div>
      <div class="stage"><div class="frame"><iframe src="/home-b" loading="eager"></iframe></div></div>
    </div>
  </div>
</body>
</html>
