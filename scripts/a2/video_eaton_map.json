 "lines": [
  {
   "a": 4.4,
   "b": 9.0,
   "d": 4.6,
   "text": "За последнее десятилетие Россия превратилась в страну с развитой рыночной экономикой,",
   "cuts": [
    0.4696
   ]
  },
  {
   "a": 9.8,
   "b": 15.4,
   "d": 5.6,
   "text": "стабильно растущими капитальными вложениями и ВВП.",
   "cuts": [
    0.3786
   ]
  },
  {
   "a": 16.2,
   "b": 19.4,
   "d": 3.2,
   "text": "Для компании Eaton, глобального поставщика решений для управления энергией,",
   "cuts": [
    0.25,
    0.7
   ]
  },
  {
   "a": 19.6,
   "b": 23.2,
   "d": 3.6,
   "text": "Россия является важнейшим растущим рынком с огромным потенциалом.",
   "cuts": [
    0.6111
   ]
  },
  {
   "a": 23.4,
   "b": 27.8,
   "d": 4.4,
   "text": "Поистине, страна колоссальных возможностей.",
   "cuts": [
    0.2727,
    0.8636
   ]
  },
  {
   "a": 28.6,
   "b": 30.2,
   "d": 1.6,
   "text": "Россия становится всё более привлекательным рынком",
   "cuts": []
  },
  {
   "a": 30.4,
   "b": 32.2,
   "d": 1.8,
   "text": "для зарубежных компаний, которые стремятся расширить здесь своё присутствие.",
   "cuts": []
  },
  {
   "a": 32.5,
   "b": 34.0,
   "d": 1.5,
   "text": "Eaton, одна из таких компаний.",
   "cuts": []
  },
  {
   "a": 34.1,
