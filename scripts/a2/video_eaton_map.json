 "sources": [
  {
   "key": "event",
   "name": "Съёмка мероприятия",
   "text": "Видеоотчёт «Дня технологий и инноваций» в Москве: стенды, доклады, разговоры у оборудования. Самый большой массив на входе и самый однородный: одна площадка, один свет, один день.",
   "shots": 41,
   "sec": 82.3
  },
  {
   "key": "moscow",
   "name": "Съёмка Москвы",
   "text": "Кадры города, доснятые под ролик. Три блока: открытие, ночная середина и подводка к финалу. Ни одного из них в присланном материале не было.",
   "shots": 14,
   "sec": 35.2
  },
  {
   "key": "sync",
   "name": "Синхрон",
   "text": "Интервью генерального директора Eaton в России Игоря Ануфриева, единственный кадр длиннее двадцати секунд.",
   "shots": 1,
   "sec": 26.5
  },
  {
   "key": "archive",
   "name": "Архив клиента",
   "text": "Промышленная и автомобильная фактура: цех, Ми-8, «Газели» на зимней дороге, разрез дифференциала с электронной блокировкой.",
   "shots": 9,
   "sec": 18.3
  },
  {
   "key": "broadcast",
   "name": "Эфир",
   "text": "Фрагмент репортажа RT «Expansion challenges» с английской студийной речью и своей эфирной плашкой.",
   "shots": 1,
   "sec": 14.8
  },
  {
   "key": "screen",
   "name": "Запись с экрана",
   "text": "Сайт Eaton и пресс-релиз Eaton Grows Presence in Russia, снятые прямо с браузера вместе со шрифтом и вёрсткой страницы.",
   "shots": 3,
   "sec": 9.9
  },
  {
   "key": "graphics",
   "name": "Графика и слайды",
   "text": "Корпоративные слайды на английском, карта мира с закрашенной Россией, рендер МС-21.",
   "shots": 4,
   "sec": 11.6
  },
  {
   "key": "nature",
   "name": "Натура",
   "text": "Укладка железнодорожного пути и тайга с горами: два кадра из общего фонда, не про Москву и не про мероприятие.",
   "shots": 2,
   "sec": 6.2
  },
  {
   "key": "titles",
   "name": "Заставка",
   "text": "Логотип Eaton на входе и на выходе плюс чёрное поле и затемнение.",
   "shots": 4,
   "sec": 12.3
  }
 ],
