# Приватная клиентская страница — вход через index.php (код доступа).
# Действует ТОЛЬКО на /for/kievskaya-ploshchad/, корневой .htaccess не затрагивает.
DirectoryIndex index.php
Options -Indexes

# Служебные файлы на «_» (превью, _analytics.php) — не отдавать напрямую
<FilesMatch "^_">
  Require all denied
</FilesMatch>

# Журнал аналитики, если он пишется рядом со страницей (запасной вариант)
RedirectMatch 404 /for/kievskaya-ploshchad/_data(/|$)

# PDF для печати отдаёт только index.php?pdf=1 после ввода пароля
<FilesMatch "\.pdf$">
  Require all denied
</FilesMatch>

# КП в Excel отдаёт только index.php?xlsx=1 после ввода пароля
<FilesMatch "\.xlsx$">
  Require all denied
</FilesMatch>
